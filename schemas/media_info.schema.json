{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "media_info",
  "description": "Probe results for one source recording (docs/PHASE0.md S2). Generated from core/contracts.py by `python -m core.contracts`; do not edit by hand.",
  "type": "object",
  "properties": {
    "container": {
      "description": "Container format name as reported by ffprobe.",
      "type": "string",
      "minLength": 1
    },
    "duration_s": {
      "description": "Container duration, seconds.",
      "type": "number",
      "minimum": 0
    },
    "size_bytes": {
      "description": "File size in bytes.",
      "type": "integer",
      "minimum": 0
    },
    "video": {
      "description": "The first video stream.",
      "type": "object",
      "properties": {
        "codec": {
          "description": "Video codec name as reported by ffprobe (e.g. h264, hevc).",
          "type": "string",
          "minLength": 1
        },
        "width": {
          "description": "Coded width in pixels, before rotation.",
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "description": "Coded height in pixels, before rotation.",
          "type": "integer",
          "minimum": 1
        },
        "rotation": {
          "description": "Clockwise rotation in degrees a player applies for display (the classic 'rotate' tag convention).",
          "type": "integer",
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "display_aspect": {
          "description": "Displayed aspect ratio after sample aspect ratio and rotation, reduced (e.g. 20:9).",
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$"
        },
        "r_frame_rate": {
          "description": "ffprobe r_frame_rate as a fraction (e.g. 30/1).",
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "avg_frame_rate": {
          "description": "ffprobe avg_frame_rate as a fraction.",
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "frame_durations_s": {
          "description": "Frame-duration statistics from packet timestamps.",
          "type": "object",
          "properties": {
            "min": {
              "description": "Shortest frame duration, seconds.",
              "type": "number",
              "minimum": 0
            },
            "median": {
              "description": "Median frame duration, seconds.",
              "type": "number",
              "minimum": 0
            },
            "max": {
              "description": "Longest frame duration, seconds.",
              "type": "number",
              "minimum": 0
            },
            "stdev": {
              "description": "Standard deviation of frame durations, seconds.",
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "min",
            "median",
            "max",
            "stdev"
          ],
          "additionalProperties": false
        },
        "is_vfr": {
          "description": "True when frame durations vary (variable frame rate).",
          "type": "boolean"
        },
        "vfr_evidence": {
          "description": "Plain-English reason for the is_vfr verdict, with the numbers behind it.",
          "type": "string"
        }
      },
      "required": [
        "codec",
        "width",
        "height",
        "rotation",
        "display_aspect",
        "r_frame_rate",
        "avg_frame_rate",
        "frame_durations_s",
        "is_vfr",
        "vfr_evidence"
      ],
      "additionalProperties": false
    },
    "audio_tracks": {
      "description": "Every audio stream in the file; empty when there is none.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "description": "Position among the file's audio streams (0 = first audio stream); the value audio.track_index refers to.",
            "type": "integer",
            "minimum": 0
          },
          "codec": {
            "description": "Audio codec name as reported by ffprobe.",
            "type": "string",
            "minLength": 1
          },
          "sample_rate": {
            "description": "Sample rate in Hz.",
            "type": "integer",
            "minimum": 1
          },
          "channels": {
            "description": "Channel count.",
            "type": "integer",
            "minimum": 1
          },
          "start_offset_s": {
            "description": "Audio stream start time minus video stream start time, seconds.",
            "type": "number"
          }
        },
        "required": [
          "index",
          "codec",
          "sample_rate",
          "channels",
          "start_offset_s"
        ],
        "additionalProperties": false
      }
    },
    "target_fps": {
      "description": "Frame rate the master will be encoded at.",
      "type": "integer",
      "enum": [
        30,
        60
      ]
    },
    "audio_track_index": {
      "description": "AudioTrack.index chosen for the master; null = video-only mode.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "warnings": {
      "description": "Plain-English warnings for the owner.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "container",
    "duration_s",
    "size_bytes",
    "video",
    "audio_tracks",
    "target_fps",
    "audio_track_index",
    "warnings"
  ],
  "additionalProperties": false
}
